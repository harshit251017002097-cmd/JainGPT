# JainGPT — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Your Google Gemini API key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (verify current model name in Google AI Studio)
GEMINI_MODEL=gemini-3.6-flash

# Max requests per IP per minute (rate limiting)
RATE_LIMIT_PER_MINUTE=20

# Environment: development | production
ENV=development

# Port for the Flask server
PORT=5000
